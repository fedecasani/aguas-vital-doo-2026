<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="600.0" prefWidth="980.0"
            style="-fx-background-color: #f4f7fb;"
            xmlns="http://javafx.com/javafx/13"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.ubp.edu.ar.ejemplocompletofx.controladores.ClientesController">

    <top>
        <VBox spacing="12.0" style="-fx-background-color: white; -fx-padding: 16 22;">
            <padding>
                <Insets bottom="16.0" left="22.0" right="22.0" top="16.0"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="12.0">
                <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #0b4f8a;"
                       text="Directorio de clientes"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label style="-fx-font-size: 11px; -fx-text-fill: #78909c;"
                       text="Zona · Barrio · Entregas"/>
            </HBox>

            <!-- Barra de búsqueda por DNI o apellido -->
            <HBox alignment="CENTER_LEFT" spacing="10.0"
                  style="-fx-background-color: #e3f2fd; -fx-background-radius: 10; -fx-padding: 12 14; -fx-border-color: #90caf9; -fx-border-radius: 10; -fx-border-width: 1;">
                <padding>
                    <Insets bottom="12.0" left="14.0" right="14.0" top="12.0"/>
                </padding>
                <Label style="-fx-font-size: 16px; -fx-text-fill: #1565c0;" text="🔍"/>
                <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                    <Label style="-fx-font-size: 11px; -fx-text-fill: #1565c0; -fx-font-weight: bold;"
                           text="BUSCAR CLIENTE"/>
                    <TextField fx:id="txtBuscar" promptText="Ingrese DNI o apellido..."
                               style="-fx-background-radius: 6; -fx-padding: 8; -fx-background-color: white;"/>
                </VBox>
                <Button fx:id="btnBuscar" onAction="#accionBuscar"
                        style="-fx-background-color: #1565c0; -fx-text-fill: white; -fx-background-radius: 6; -fx-padding: 10 22; -fx-font-weight: bold; -fx-cursor: hand;"
                        text="Buscar"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="8.0" style="-fx-padding: 0 22 16 22;">
            <padding>
                <Insets bottom="16.0" left="22.0" right="22.0" top="0.0"/>
            </padding>
            <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #37474f;"
                   text="Clientes registrados"/>
            <TableView fx:id="tablaClientes"
                       style="-fx-background-radius: 8; -fx-border-color: #cfd8dc; -fx-border-radius: 8;"
                       VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn prefWidth="130.0" text="Apellido"/>
                    <TableColumn prefWidth="120.0" text="Nombre"/>
                    <TableColumn prefWidth="110.0" text="DNI"/>
                    <TableColumn prefWidth="120.0" text="Teléfono"/>
                    <TableColumn prefWidth="200.0" text="Dirección"/>
                    <TableColumn prefWidth="140.0" text="Barrio / Zona"/>
                </columns>
            </TableView>
        </VBox>
    </center>

    <right>
        <VBox prefWidth="320.0" spacing="0.0"
              style="-fx-background-color: white; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 0 1; -fx-padding: 20;">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
            </padding>

            <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1565c0;"
                   text="Alta / edición"/>
            <Label style="-fx-font-size: 11px; -fx-text-fill: #78909c; -fx-padding: 0 0 10 0;"
                   text="Complete los datos del cliente"/>
            <Separator style="-fx-padding: 0 0 14 0;"/>

            <GridPane hgap="12.0" vgap="14.0" VBox.vgrow="ALWAYS">
                <columnConstraints>
                    <ColumnConstraints minWidth="90.0" prefWidth="100.0"/>
                    <ColumnConstraints hgrow="ALWAYS" minWidth="160.0"/>
                </columnConstraints>
                <rowConstraints>
                    <RowConstraints minHeight="36.0"/>
                    <RowConstraints minHeight="36.0"/>
                    <RowConstraints minHeight="36.0"/>
                    <RowConstraints minHeight="36.0"/>
                    <RowConstraints minHeight="36.0"/>
                    <RowConstraints minHeight="36.0"/>
                </rowConstraints>

                <Label style="-fx-text-fill: #546e7a; -fx-font-weight: bold;"
                       text="Nombre:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <TextField fx:id="txtNombre" promptText="Nombre"
                           style="-fx-background-radius: 6; -fx-padding: 8;"
                           GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <Label style="-fx-text-fill: #546e7a; -fx-font-weight: bold;"
                       text="Apellido:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <TextField fx:id="txtApellido" promptText="Apellido"
                           style="-fx-background-radius: 6; -fx-padding: 8;"
                           GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <Label style="-fx-text-fill: #546e7a; -fx-font-weight: bold;"
                       text="DNI:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <TextField fx:id="txtDni" promptText="Documento"
                           style="-fx-background-radius: 6; -fx-padding: 8;"
                           GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                <Label style="-fx-text-fill: #546e7a; -fx-font-weight: bold;"
                       text="Teléfono:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                <TextField fx:id="txtTelefono" promptText="Ej: 221-5551234"
                           style="-fx-background-radius: 6; -fx-padding: 8;"
                           GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                <Label style="-fx-text-fill: #546e7a; -fx-font-weight: bold;"
                       text="Dirección:" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                <TextField fx:id="txtDireccion" promptText="Calle y número"
                           style="-fx-background-radius: 6; -fx-padding: 8;"
                           GridPane.columnIndex="1" GridPane.rowIndex="4"/>

                <Label style="-fx-text-fill: #546e7a; -fx-font-weight: bold;"
                       text="Barrio:" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
                <ComboBox fx:id="cmbBarrio" maxWidth="Infinity" promptText="Barrio / Zona"
                          style="-fx-background-radius: 6;"
                          GridPane.columnIndex="1" GridPane.rowIndex="5"/>
            </GridPane>

            <HBox alignment="CENTER" spacing="8.0" style="-fx-padding: 16 0 0 0;">
                <padding>
                    <Insets top="16.0"/>
                </padding>
                <Button fx:id="btnGuardar" onAction="#accionGuardar"
                        style="-fx-background-color: #1565c0; -fx-text-fill: white; -fx-background-radius: 6; -fx-padding: 10 18; -fx-font-weight: bold; -fx-cursor: hand;"
                        text="Guardar"/>
                <Button fx:id="btnEliminar" onAction="#accionEliminar"
                        style="-fx-background-color: #c62828; -fx-text-fill: white; -fx-background-radius: 6; -fx-padding: 10 16; -fx-cursor: hand;"
                        text="Eliminar"/>
                <Button fx:id="btnLimpiar" onAction="#accionLimpiar"
                        style="-fx-background-color: #eceff1; -fx-text-fill: #37474f; -fx-background-radius: 6; -fx-padding: 10 16; -fx-cursor: hand;"
                        text="Limpiar"/>
            </HBox>
        </VBox>
    </right>
</BorderPane>
